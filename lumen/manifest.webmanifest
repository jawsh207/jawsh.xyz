{
  "id": "./",
  "name": "Lumen for Nostr",
  "short_name": "Lumen",
  "description": "A Material You client for Nostr with zaps and Amber sign-in",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#fbf8fe",
  "theme_color": "#fbf8fe",
  "categories": ["social"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "New post", "short_name": "Post", "url": "./#/compose", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Wallet", "url": "./#/wallet", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "protocol_handlers": [{ "protocol": "web+nostr", "url": "./#/open/%s" }]
}
